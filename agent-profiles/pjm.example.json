{
  "schema_version": 2,
  "name": "example-pjm",
  "scheduler": "pjm",
  "work_root": ".mdtbx/runs",
  "runner_argv": ["python", "-m", "mdtbx"],
  "environment": {
    "prologue": [],
    "env": {}
  },
  "policy": {
    "batch_classes": ["data", "quantum", "gpu", "md"],
    "memory_safety_factor": 1.25,
    "walltime_safety_factor": 1.5,
    "minimum_confidence": 0.7,
    "pilot_walltime_seconds": 600,
    "poll_min_seconds": 60,
    "poll_max_seconds": 300
  },
  "resources": [
    {
      "name": "configure-me",
      "classes": ["data", "quantum", "gpu", "md"],
      "capabilities": {
        "cpus_per_node": 1,
        "gpus_per_node": 0,
        "memory_mb_per_node": 4096
      },
      "limits": {
        "max_nodes": 1,
        "max_walltime_seconds": 3600
      },
      "scheduler_options": {
        "resource_group": "configure-me",
        "group": "configure-me",
        "dependency_args": ["--sparam", "jid={job_ids}"],
        "extra_directives": []
      },
      "incomplete": true
    }
  ]
}
